{
  "name": "elementor-mcp",
  "version": "1.3.0",
  "description": "MCP server for deep, safe control of Elementor and WordPress sites",
  "license": "MIT",
  "type": "module",
  "bin": {
    "elementor-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "plugin",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm test && npm run build && node tests/smoke.mjs && node tests/capability-guard.mjs && php tests/plugin-load.php && php tests/tree-mutators.php && php tests/mcp-endpoint.php && php tests/oauth-flow.php",
    "prepublishOnly": "npm run build",
    "docs": "npm run build && node tests/gen-tool-docs.mjs > docs/TOOLS.md",
    "smoke": "npm run build && node tests/smoke.mjs",
    "package:plugin": "./scripts/package-plugin.sh",
    "test:plugin": "php tests/plugin-load.php",
    "test:guard": "npm run build && node tests/capability-guard.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "elementor",
    "wordpress",
    "page-builder",
    "ai"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  }
}
