# Single site
WORDPRESS_URL=https://example.com
WORDPRESS_USERNAME=your-wp-user
# Users > Profile > Application Passwords in wp-admin. Not the login password.
WORDPRESS_APP_PASSWORD=abcd efgh ijkl mnop qrst uvwx

# Several sites (overrides the single-site variables above)
# ELEMENTOR_MCP_SITES=[{"name":"live","url":"https://example.com","username":"u","appPassword":"..."}]
# ELEMENTOR_MCP_DEFAULT_SITE=live

# Refuse every write, across all sites
# ELEMENTOR_MCP_READ_ONLY=true

# Per-request timeout in milliseconds
# ELEMENTOR_MCP_TIMEOUT_MS=30000
